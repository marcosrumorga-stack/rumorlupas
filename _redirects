# A league inside a category is the catalogue, opened on that league.
# script.js reads the address back; the edge function writes the head.
/en/camisas/liga/*  /index.html  200
/es/camisas/liga/*  /index.html  200
/camisas/liga/*  /index.html  200

# Serve the product page at its own address without changing the bar.
# One pair of rules per category that has products in it.
/en/lupas/*  /produto.html  200
/es/lupas/*  /produto.html  200
/lupas/*  /produto.html  200
/en/camisas/*  /produto.html  200
/es/camisas/*  /produto.html  200
/camisas/*  /produto.html  200

# The Meta catalogue feed. Generated per request from products.js rather
# than kept as a file, so a sale cannot leave a sold pair being advertised
# until someone remembers to regenerate it. The address is the one already
# registered in Commerce Manager, so it has to keep working.
/meta-feed.csv  /.netlify/functions/meta-feed  200

# The translated addresses are the same files, read in another language:
# i18n.js takes the language from the prefix that is still in the address bar.
# Netlify ignores the trailing slash when it matches, so the first rule
# answers both /en and /en/. Do not add a /en -> /en/ redirect: it matches
# /en/ as well and the address redirects to itself, forever.
/en/  /index.html  200
/en/*  /:splat  200
/es/  /index.html  200
/es/*  /:splat  200
