# Netlify serves every file with "public, max-age=0, must-revalidate". That is
# the safe default, and for the HTML and the scripts it is the right one - but
# it also means a returning visitor asks the server about every photo and about
# the font before the page can be drawn. On a phone that is a round trip each,
# and the answer is almost always "unchanged".
#
# What is safe to keep is what does not change under its own name.

# Photos. A name always holds the same picture - a new model gets a new folder,
# and the sized copies are rebuilt from the originals. Replacing a photo in
# place is the one case this delays, so a returning visitor can be up to a day
# behind; stale-while-revalidate then updates it in the background, without
# anyone waiting. Worth a day for a load that draws instantly.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Bungee, subset and self-hosted. These two files will never change: a
# different subset would be a different name. A year, and never ask again.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Deliberately not listed: the HTML, the stylesheet and the scripts. Their
# names never change but their contents do, with every deploy, and a visitor
# running yesterday's cart.js against today's page is a real way to break a
# checkout. Those keep asking.
